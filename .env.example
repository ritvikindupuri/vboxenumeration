# Environment variables for container-security-ai-soc
# Copy to .env and fill in your credentials

# --- GEMINI AI ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# --- ELASTICSEARCH (Cloud or Self-hosted) ---
# Option A: Elastic Cloud
ES_CLOUD_ID=your_cloud_id_here
ES_API_KEY=your_api_key_here
ES_API_KEY_ID=your_api_key_id_here

# Option B: Self-hosted Elasticsearch
ES_HOST=https://localhost:9200
ES_USERNAME=elastic
ES_PASSWORD=your_es_password_here

# --- FALCO ---
FALCO_GRPC_HOST=localhost
FALCO_GRPC_PORT=5060

# --- DASHBOARD ---
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080

# --- AGENT BEHAVIOR ---
AUTO_BLOCK_ENABLED=true
CONFIDENCE_THRESHOLD=0.6
